---
import Main from "../layouts/Main.astro";
---

<Main title="المحادثة" description="Pineapple AI — محادثة فورية مع نماذج حية.">
  <section id="models" aria-labelledby="models-h">
    <h2 id="models-h">النموذج</h2>
    <label for="model-select">اختر النموذج</label>
    <select id="model-select" aria-describedby="model-status"></select>
    <p id="model-status" role="status"></p>
  </section>

  <section id="chat" aria-labelledby="chat-h">
    <h2 id="chat-h" class="sr-only">المحادثة</h2>
    <div class="top-bar">
      <a class="icon-btn" href="/" aria-label="القائمة الرئيسية">☰</a>
      <span class="name-pill" aria-hidden="true">✦ Pineapple AI</span>
      <button id="chat-new" class="icon-btn" type="button" aria-label="محادثة جديدة">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
        </svg>
      </button>
    </div>

    <div id="chat-log" class="chat-area" aria-live="polite" aria-label="سجل المحادثة"></div>

    <div id="plus-menu" class="plus-menu" hidden>
      <button id="plus-new" type="button">محادثة جديدة</button>
      <button id="plus-model" type="button">تغيير النموذج</button>
    </div>

    <form id="chat-form" class="input-area">
      <label class="sr-only" for="chat-input">رسالتك</label>
      <button id="chat-plus" class="icon-btn" type="button" aria-label="خيارات إضافية">+</button>
      <input id="chat-input" class="pill" type="text" placeholder="اسأل Pineapple" autocomplete="off" aria-label="رسالتك" />
      <button id="chat-send" class="icon-btn send" type="submit" aria-label="أرسل الرسالة">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 19V5" />
          <path d="M5 12l7-7 7 7" />
        </svg>
      </button>
      <button id="chat-stop" class="icon-btn stop" type="button" hidden aria-label="أوقف التوليد">■</button>
    </form>
  </section>
</Main>

<script>
  import { initModels } from "../islands/models.ts";
  import { initChat } from "../islands/chat.ts";
  initModels();
  initChat();
</script>

<style>
  .top-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 60px;
  }
  .icon-btn {
    inline-size: 44px;
    block-size: 44px;
    flex: none;
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid color-mix(in srgb, var(--muted) 45%, transparent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
  }
  .name-pill {
    border: 1px solid color-mix(in srgb, var(--muted) 45%, transparent);
    border-radius: 999px;
    padding: 0.55rem 1rem;
    font-weight: 700;
    margin-inline-start: 0.25rem;
  }
  #chat-new { margin-inline-start: auto; }
  .chat-area {
    min-block-size: 16rem;
  }
  .msg-user p {
    background: var(--brand);
    color: #000;
    border-radius: 1rem;
    padding: 0.6rem 0.9rem;
    inline-size: fit-content;
    max-inline-size: 75%;
    margin-inline-start: auto;
    overflow-wrap: break-word;
  }
  .msg-ai p { margin-block: 0.5rem; }
  .plus-menu {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-block: 0.5rem;
  }
  .plus-menu[hidden] { display: none; }
  .plus-menu button {
    text-align: start;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid color-mix(in srgb, var(--muted) 45%, transparent);
    border-radius: 0.75rem;
    padding: 0.7rem 1rem;
    font: inherit;
    min-block-size: 44px;
    cursor: pointer;
  }
  .input-area {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 60px;
  }
  .pill {
    flex: 1;
    min-inline-size: 0;
    border-radius: 999px;
    font-size: 1rem;
  }
  .send {
    background: var(--brand);
    color: #000;
    border-color: transparent;
    font-weight: 700;
  }
  .send:disabled { opacity: 0.55; cursor: not-allowed; }
  .stop { border-color: var(--danger, #B3261E); color: var(--danger, #B3261E); }
</style>
