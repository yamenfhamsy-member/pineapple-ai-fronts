---
import Main from "../layouts/Main.astro";
---

<Main title="المحادثة" description="Pineapple AI — محادثة فورية مع نماذج حية.">
  <section id="chat" class="chat-app" aria-labelledby="chat-h">
    <h2 id="chat-h" class="sr-only">المحادثة</h2>

    <div class="top-bar" dir="ltr">
      <button id="menu-btn" class="icon-btn" type="button" aria-label="فتح القائمة">
        <span class="lines" aria-hidden="true"><span></span><span></span></span>
      </button>
      <button id="model-pill" class="app-name" type="button" aria-label="النموذج الحالي — اضغط للتغيير">Pineapple AI</button>
      <button id="chat-new" class="new-pill" type="button">✦ جديد</button>
    </div>

    <div id="chat-main" class="chat-main" dir="ltr">
      <div id="chat-log" aria-live="polite" aria-label="سجل المحادثة"></div>
      <div id="chat-empty" class="empty">
        <button type="button" data-text="أنشئ صورة">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
            <circle cx="9" cy="9" r="2" />
            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
          </svg>
          إنشاء صورة
        </button>
        <button type="button" data-text="ساعدني في الكتابة أو التعديل">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 3a2.8 2.8 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
          </svg>
          كتابة أو تعديل
        </button>
        <button type="button" data-text="ابحث لي عن شيء">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
          </svg>
          البحث عن شيء
        </button>
      </div>
    </div>

    <form id="chat-form" class="input-area" dir="ltr">
      <label class="sr-only" for="chat-input">رسالتك</label>
      <button id="chat-plus" class="icon-btn" type="button" aria-label="خيارات إضافية">+</button>
      <input id="chat-input" class="pill" type="text" placeholder="اسأل Pineapple" autocomplete="off" />
      <button id="chat-send" class="icon-btn send" type="submit" aria-label="أرسل الرسالة">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 19V5" />
          <path d="M5 12l7-7 7 7" />
        </svg>
      </button>
      <button id="chat-stop" class="icon-btn stop" type="button" hidden aria-label="أوقف التوليد">■</button>
      <button id="chat-mic" class="icon-btn" type="button" aria-label="إدخال صوتي">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" />
          <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
          <line x1="12" x2="12" y1="19" y2="22" />
        </svg>
      </button>
    </form>

    <div id="side-backdrop" class="backdrop" hidden></div>
    <aside id="sidebar" class="sidebar" aria-label="القائمة الجانبية">
      <button id="side-close" class="icon-btn" type="button" aria-label="إغلاق القائمة">×</button>
      <h3>المحادثات</h3>
      <input id="history-search" type="search" placeholder="ابحث في المحادثات" aria-label="ابحث في المحادثات" autocomplete="off" />
      <div id="chat-history" class="history" role="list"></div>
      <div class="row">
        <button id="export-md" class="mini-btn" type="button">تصدير MD</button>
        <button id="export-copy" class="mini-btn" type="button">نسخ الكل</button>
      </div>
      <h3>الأدوات</h3>
      <button id="tool-image" class="menu-link" type="button">توليد صورة</button>
      <h3>النموذج</h3>
      <label for="model-select">اختر النموذج</label>
      <select id="model-select" aria-describedby="model-status"></select>
      <p id="model-status" role="status"></p>
      <a class="menu-link" href="/settings">الإعدادات</a>
    </aside>
  </section>
</Main>

<script>
  import { initModels } from "../islands/models.ts";
  import { initChat } from "../islands/chat.ts";
  initModels();
  initChat();
</script>

<style>
  /* App-like column: sticky header, growing scroll area, sticky input bar. */
  #chat {
    background: transparent;
    border: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    min-block-size: 100dvh;
  }
  .top-bar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 60px;
  }
  .app-name {
    text-align: center;
    font-size: 1.05rem;
    font-weight: 700;
    background: none;
    border: 0;
    color: inherit;
    font-family: inherit;
    cursor: pointer;
    min-block-size: 44px;
  }
  .new-pill {
    border: 1px solid color-mix(in srgb, var(--muted) 45%, transparent);
    background: var(--surface);
    color: var(--ink);
    border-radius: 999px;
    padding: 0.5rem 0.9rem;
    font: inherit;
    font-weight: 700;
    min-block-size: 44px;
    cursor: pointer;
  }
  .icon-btn {
    inline-size: 44px;
    block-size: 44px;
    flex: none;
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid color-mix(in srgb, var(--muted) 45%, transparent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
  }
  .lines {
    display: flex;
    flex-direction: column;
    gap: 4px;
    inline-size: 18px;
  }
  .lines span {
    display: block;
    block-size: 2px;
    background: currentColor;
    border-radius: 2px;
  }
  .lines span:nth-child(2) { inline-size: 70%; }
  .chat-main {
    flex: 1;
    overflow-y: auto;
    padding-block: 0.5rem;
  }
  /* The scroll lives on .chat-main now — the log itself is a flat flow. */
  #chat-log {
    min-block-size: 0;
    max-block-size: none;
    overflow: visible;
    border: 0;
    padding: 0;
    margin: 0;
  }
  /* LTR user bubble on the right (clone shape). */
  #chat-log .msg-user p {
    margin-inline-start: 0;
    margin-inline-end: auto;
  }
  .empty {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-inline-start: 0.5rem;
    padding-block: 1rem;
  }
  .empty[hidden] { display: none; }
  .empty button {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: none;
    color: var(--ink);
    border: 0;
    padding: 0.25rem;
    font: inherit;
    font-size: 1rem;
    min-block-size: 44px;
    cursor: pointer;
    text-align: start;
  }
  .input-area {
    position: sticky;
    bottom: 0;
    z-index: 10;
    background: var(--bg);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 60px;
    padding-block: 0.25rem;
  }
  .pill {
    flex: 1;
    min-inline-size: 0;
    border-radius: 999px;
    font-size: 1rem;
  }
  .send {
    background: var(--brand);
    color: #000;
    border-color: transparent;
    font-weight: 700;
  }
  .send:disabled { opacity: 0.55; cursor: not-allowed; }
  .stop { border-color: var(--danger, #B3261E); color: var(--danger, #B3261E); }
  /* Sidebar drawer from the left (clone shape). */
  .backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 40;
  }
  .backdrop[hidden] { display: none; }
  .sidebar {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    inline-size: min(18rem, 85vw);
    background: var(--surface);
    z-index: 50;
    overflow-y: auto;
    padding: 1rem;
    box-shadow: 0 0 2rem rgba(0, 0, 0, 0.25);
    transform: translateX(-105%);
    transition: transform 0.2s ease;
  }
  .sidebar.open { transform: none; }
  .sidebar .menu-link {
    display: flex;
    align-items: center;
    min-block-size: 44px;
    margin-block-start: 0.5rem;
  }
  button.menu-link {
    background: none;
    border: 0;
    color: var(--ink);
    font: inherit;
    cursor: pointer;
    padding: 0;
    text-align: start;
  }
  .history { display: flex; flex-direction: column; gap: 0.25rem; }
  .history-row { display: flex; align-items: center; gap: 0.25rem; }
  .history-open {
    flex: 1;
    min-inline-size: 0;
    text-align: start;
    background: none;
    border: 0;
    color: var(--ink);
    font: inherit;
    border-radius: 0.5rem;
    padding: 0.6rem 0.5rem;
    cursor: pointer;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-block-size: 44px;
  }
  .history-open small { display: block; color: var(--muted); font-size: 0.8rem; }
  .history-del {
    flex: none;
    inline-size: 44px;
    block-size: 44px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--muted) 45%, transparent);
    background: none;
    color: var(--muted);
    font-size: 1.1rem;
    cursor: pointer;
  }
  .history-empty { color: var(--muted); font-size: 0.9rem; }
</style>
