---
import Main from "../layouts/Main.astro";
---

<Main title="الصور" description="Pineapple AI — استخراج النص من الصور العامة.">
  <section id="ocr" aria-labelledby="ocr-h">
    <h2 id="ocr-h">استخراج النص من الصور (OCR)</h2>
    <form id="ocr-form">
      <label for="ocr-urls">روابط الصور العامة (حتى 10، سطر لكل رابط)</label>
      <textarea id="ocr-urls" rows="3" dir="ltr"></textarea>
      <label for="ocr-sys">تعليمات إضافية (اختياري)</label>
      <input id="ocr-sys" type="text" autocomplete="off" />
      <button id="ocr-send" class="btn-brand" type="submit" aria-label="استخرج النص من الصور">استخرج</button>
    </form>
    <div id="ocr-out" aria-live="polite"></div>
  </section>
</Main>

<script>
  import { initOcr } from "../islands/ocr.ts";
  initOcr();
</script>
