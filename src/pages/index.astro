---
import Main from "../layouts/Main.astro";
import Hero from "../components/Hero.astro";

// Zero-JS welcome page: static HTML only, no <script>.
const tools = [
  { href: "/chat", name: "المحادثة", desc: "اسأل وأجب فورياً — 43 نموذجاً مع بث الرد وإيقاف التوليد." },
  { href: "/ocr", name: "الصور", desc: "استخراج النص من الصور العامة (حتى 10 روابط)." },
  { href: "/tts", name: "الصوت", desc: "تحويل النص إلى صوت مسموع (حتى 1000 حرف)." },
  { href: "/settings", name: "الإعدادات", desc: "الحرارة وتعليمات النظام." },
];
---

<Main title="مساعد عربي" description="Pineapple AI — مساعد عربي سريع: محادثة وصوت وصور.">
  <Hero />

  <section aria-labelledby="tools-h">
    <h2 id="tools-h">الأدوات</h2>
    <div class="cards">
      {tools.map((t) => (
        <article class="card">
          <h3>{t.name}</h3>
          <p>{t.desc}</p>
          <a class="btn-brand card-cta" href={t.href} aria-label={`افتح ${t.name}`}>افتح</a>
        </article>
      ))}
    </div>
  </section>
</Main>

<style>
  .cards {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .card {
    border: 1px solid color-mix(in srgb, var(--muted) 25%, transparent);
    border-radius: 1rem;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .card h3 { margin: 0; }
  .card p { margin: 0 0 0.5rem; color: var(--muted); }
  .card-cta {
    align-self: start;
    text-decoration: none;
  }
</style>
